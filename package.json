{
  "name": "@gxx-labs/browser-use-dsh",
  "version": "0.9.2",
  "description": "DSH Desktop 可见协作/批注层：在内建右侧 Browser 中把 Agent 的观察、操作、批注与审批可视化；不是官方 Browser Use Provider 的替代。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/"
  ],
  "scripts": {
    "verify": "node scripts/verify-bundle.mjs",
    "test": "node scripts/run-tests.mjs",
    "pack-check": "node scripts/verify-pack.mjs",
    "check": "npm run verify && npm test && npm run pack-check"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "browser-use",
    "browser",
    "webview"
  ],
  "author": "gxx-labs",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
